#!/usr/bin/env sh
cd "$(dirname "$0")/.." || exit 1

# GUI git clients (GitHub Desktop, Cursor) skip shell rc files — mirror the
# pre-commit preamble so node/pnpm are on PATH when the hook runs.
export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  # shellcheck source=/dev/null
  . "$NVM_DIR/nvm.sh"
  nvm use --silent 2>/dev/null || true
fi

if ! command -v node >/dev/null 2>&1; then
  case "$(uname -s 2>/dev/null)" in
    MINGW*|MSYS*|CYGWIN*)
      for dir in "/c/Program Files/nodejs" "/c/Program Files (x86)/nodejs"; do
        [ -x "$dir/node.exe" ] && export PATH="$dir:$PATH" && break
      done
      [ -d "$HOME/AppData/Roaming/npm" ] && export PATH="$HOME/AppData/Roaming/npm:$PATH"
      ;;
  esac
fi

node scripts/check-machine-identity-leak.mjs --message "$1" || exit 1
pnpm exec commitlint --edit "$1"
