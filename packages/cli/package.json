{
  "name": "skilletmd",
  "version": "0.1.34",
  "description": "Your skills, everywhere. Agent skills that sync to every computer, agent, and surface you use.",
  "type": "module",
  "bin": {
    "skillet": "./dist/index.js"
  },
  "files": [
    "dist/cli.cjs",
    "dist/cli.cjs.map",
    "dist/bundled-skills"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skilletmd/skillet.git",
    "directory": "packages/cli"
  },
  "dependencies": {
    "@clack/prompts": "^1.6.0",
    "@skillet/adapters-claude-code": "workspace:*",
    "@skillet/adapters-codex": "workspace:*",
    "@skillet/adapters-cursor": "workspace:*",
    "@skillet/adapters-devin": "workspace:*",
    "@skillet/adapters-hermes": "workspace:*",
    "@skillet/adapters-opencode": "workspace:*",
    "@skillet/adapters-openclaw": "workspace:*",
    "@skillet/adapters-windsurf": "workspace:*",
    "@skillet/core": "workspace:*",
    "@skillet/mcp": "workspace:*",
    "@skillet/protocol": "workspace:*",
    "commander": "^12.1.0"
  },
  "scripts": {
    "build": "tsc",
    "bundle": "node scripts/bundle-cli.mjs",
    "build-native": "node scripts/build-native.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-cli-deps.mjs && pnpm bundle && node --import ./tests/scrub-env.mjs --import tsx/esm --test tests/*.test.ts",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepublishOnly": "node scripts/build-cli-deps.mjs && pnpm bundle && node scripts/verify-publish-artifacts.mjs && node scripts/publish-prep.mjs",
    "postpublish": "node scripts/publish-restore.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "license": "Apache-2.0"
}
