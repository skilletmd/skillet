# @skillet/registry — copy to `.env` for `pnpm --filter @skillet/registry dev`
#
# This file is the reference for registry config. Web config lives in
# ../web/.env.example; CLI env vars are documented in the CLI docs.
# Start web + registry together from repo root: `pnpm dev`
#
# Env prefix: SKILLET_* for all Skillet configuration.

NODE_ENV=development
PORT=3481
HOST=0.0.0.0
# Prisma + MySQL. Docker compose publishes :3307; native MySQL usually :3306.
#   docker compose -f docker-compose.mysql.yml up -d
#   # or native 8.x utf8mb4 — see README "Run" for CREATE DATABASE/USER
# Live proofs: pnpm test:mysql (SKILLET_MYSQL_TESTS=1). Use a disposable DB.
DATABASE_URL=mysql://skillet:skillet@127.0.0.1:3307/skillet_registry
# DATABASE_URL=mysql://skillet:skillet@127.0.0.1:3306/skillet_registry
# Legacy REGISTRY_DB_PATH has been removed — relational data is MySQL-only.

# Blob storage — `r2` for prod; `memory` for BlobStore-only tests. When unset:
# R2 if credentials are present, otherwise memory when DATABASE_URL/Prisma is set.
# BLOB_STORE=r2
# BLOB_STORE=memory
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_KEY_PREFIX=registry-blobs

# Avatar object storage — a SEPARATE public R2 bucket, required in every env (no
# sqlite fallback). Reuses R2_ACCOUNT_ID/R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY.
# R2_AVATARS_BUCKET=skillet-avatars
# R2_AVATARS_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev   # public bucket URL (r2.dev or custom domain)
# R2_AVATARS_KEY_PREFIX=dev/                               # dev/ locally; empty in prod

# GitHub OAuth — prefer AUTH_*. The legacy GITHUB_OAUTH_CLIENT_ID /
# GITHUB_OAUTH_CLIENT_SECRET / GITHUB_OAUTH_REDIRECT_URI names are still read as
# a fallback; don't set both.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_GITHUB_REDIRECT_URI=http://127.0.0.1:3481/api/v1/auth/github/callback

# Local-only auth relaxations: deterministic session signing, a returned
# `dev_code` on login, and a dev repo-token key. The registry REFUSES TO BOOT
# with this set while NODE_ENV=production. Never set it where real tokens live.
# SKILLET_ENABLE_DEV_AUTH=1

# Sync and content reads require auth by default. Set "false" only in local dev
# when you need anonymous reads.
# SKILLET_REGISTRY_REQUIRE_AUTH_FOR_CONTENT=true

SKILLET_WEB_URL=http://localhost:3000
# Canonical external origin for hosted MCP link URLs. Required in production when
# callers reach this service on loopback (web BFF) or a proxy rewrites Host.
# SKILLET_REGISTRY_PUBLIC_URL=https://registry.skillet.md
SKILLET_SESSION_TTL_SEC=1209600

# HMAC secret the web BFF signs internal registry calls with, and the registry
# verifies (session mint/refresh, identity link, repo connect). Must match the web
# app's SKILLET_WEB_SIGNING_SECRET exactly. Generate a fresh value — do NOT ship a
# well-known default:  openssl rand -hex 32
# These internal routes must NEVER be internet-routable (private network only).
SKILLET_WEB_SIGNING_SECRET=
# Optional second secret accepted during zero-downtime rotation (set the new value
# above, the old one here; drop this once every caller re-signs with the new one):
# SKILLET_WEB_SIGNING_SECRET_PREVIOUS=

# Network-origin lock for those internal routes (auth/web, auth/link, github/repos).
# The HMAC signature above is ONE factor — a leaked secret alone would be account
# takeover. Set this to the trusted IMMEDIATE TCP peer(s) (comma-separated IPs /
# CIDRs) and the registry 404s those routes for any other peer. Use loopback when
# the web BFF is co-located, or the private range when it reaches the registry over
# an internal network. Behind Cloudflare the peer is CF's edge for everyone, so
# pair CF ranges here with Authenticated Origin Pulls / mTLS at the edge.
# Unset → no lock (the registry logs a warning at boot). Examples:
#   SKILLET_INTERNAL_ORIGIN_ALLOWLIST=127.0.0.1,::1
#   SKILLET_INTERNAL_ORIGIN_ALLOWLIST=10.0.0.0/8
# SKILLET_INTERNAL_ORIGIN_ALLOWLIST=

# Production magic-link email (Resend — https://resend.com)
# RESEND_API_KEY=re_...
# MAGIC_LINK_FROM_EMAIL=Skillet <login@skillet.md>

# Behind Caddy/nginx/Cloudflare in production — required for per-IP rate keys
# (ambient light GETs, write backstop, heavy reads, magic-link caps). Wrong or
# missing TRUST_PROXY collapses every client into one bucket.
# TRUST_PROXY=1

# HTTP rate classes (per client IP / minute). Ambient = light non-heavy GET/HEAD
# (default 2000). Write = POST/PUT/PATCH/DELETE backstop (default 300). Heavy
# download/sync/diff stays at 60 and is not diluted by ambient. MCP serve is
# exempt from ambient+write (see ratelimit/mcp.ts).
# SKILLET_AMBIENT_RATE_PER_MINUTE=2000
# SKILLET_WRITE_RATE_PER_MINUTE=300
# Deprecated ambient fallback only (ignored when AMBIENT is set):
# SKILLET_GLOBAL_RATE_PER_MINUTE=300

# REQUIRED if you use connect-your-repo: GitHub OAuth tokens are encrypted at
# rest with this key. Token storage FAILS CLOSED without it — a missing key
# throws rather than falling back to a source-readable dev key. Generate:
#   openssl rand -hex 32
# Local/test only: SKILLET_ENABLE_DEV_AUTH=1 permits a deterministic dev key —
# never set that where real tokens are stored. The registry REFUSES TO BOOT with
# that flag while NODE_ENV=production, so it can't be used to paper over a missing
# key in prod — set the real key below instead.
# SKILLET_REPO_TOKEN_KEY=

# REQUIRED for the hosted MCP endpoint (/api/v1/mcp): link secrets are encrypted
# at rest with this key so settings can re-display them. Fails closed in
# production when unset. Rotating it orphans existing links (users must
# regenerate). Generate:  openssl rand -hex 32
# SKILLET_MCP_TOKEN_KEY=

# Optional: signed adapter manifest key (hex Ed25519 PKCS#8 private key)
# SKILLET_ADAPTER_RELEASE_KEY=

# Brand-handle claim allowlist. Comma-separated handle:email pairs.
# SKILLET_BRAND_CLAIM_ALLOWLIST=skillet:you@company.com

# Platform admin allowlists (comma-separated). Handle list is mutable; prefer
# SKILLET_ADMIN_USER_IDS (stable registry user ids) when both are configured.
# SKILLET_ADMIN_HANDLES=taylor,thiago
# SKILLET_ADMIN_USER_IDS=usr_abc123,usr_def456

# Temporary browse-stampede SQLite hypothesis experiment (unset after verdict).
# SKILLET_SQLITE_STALL_PROBE=1 logs query wall time, SQLITE_BUSY, and event-loop lag.
# SKILLET_CATALOG_SQLITE_BYPASS=1 serves empty skills/kits/people catalogs without SQLite.
