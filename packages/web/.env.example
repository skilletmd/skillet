# @skillet/web — copy to `.env.local` for local dev (Next loads `.env.local`
# ahead of `.env`, and it is gitignored).
#
# This file is the reference for web config. Registry config lives in
# ../registry/.env.example. Start both from repo root: `pnpm dev`
#
# Env prefix: SKILLET_* for all Skillet configuration.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server→registry fetch origin (SSR / BFF). Prefer loopback on the same box so
# browse never hairpins through Cloudflare.
REGISTRY_URL=http://127.0.0.1:3481
# Public registry origin printed in the UI (MCP connector URL, etc.). Not used
# for server fetches when REGISTRY_URL is set.
NEXT_PUBLIC_REGISTRY_PUBLIC_URL=http://127.0.0.1:3481
# Legacy alias still accepted as fetch fallback / public fallback when the
# vars above are unset. Prefer REGISTRY_URL + NEXT_PUBLIC_REGISTRY_PUBLIC_URL.
# NEXT_PUBLIC_REGISTRY_URL=http://127.0.0.1:3481

# Max concurrent outbound skill/kit/people catalog fetches from this Node process
# (browse SSR stampede gate). Default 3. Raise only if registry + web have headroom.
# SKILLET_CATALOG_FETCH_CONCURRENCY=3
# Wall-clock budget (ms) for gate wait + registry fetch. Default 4000 so soft-fail
# wins before Cloudflare's origin timeout under browse spam.
# SKILLET_CATALOG_FETCH_TIMEOUT_MS=4000
# Shared Redis cache for catalog SSR JSON (60s TTL). Unset = skip (fail-open).
# Local / direct:
#   SKILLET_REDIS_URL=redis://127.0.0.1:6379
# Prod Sentinel (same shape as nft-generator; no hardcoded hosts):
#   REDIS_PROD=true
#   REDIS_SENTINELS=[{"host":"10.0.0.1","port":26379},{"host":"10.0.0.2","port":26379}]
#   REDIS_MAIN_NAME=mymaster
#   REDIS_PASSWORD=
#   REDIS_CACHE_DB=0
# Prod browse SSR probe: [browse-ssr] page_start/auth/redis_*/gate_*/fetch_*/
# soft_ok|soft_fail/follows/catalog_outcome/page_done with rid + elapsed_ms
# (noisy; unset after rides). Grep web stdout / pm2 logs for [browse-ssr].
# SKILLET_BROWSE_SSR_PROBE=1
# Legacy alias for the same probe:
# SKILLET_CATALOG_GATE_LOG=1

# Public hostname of the avatar-upload bucket, so next/image may optimize
# uploaded avatars (bare host, or a full URL — only the hostname is used).
# Pair with the registry's R2_AVATARS_PUBLIC_BASE_URL. Unset = uploaded avatars
# render `unoptimized`, which is safe, just unoptimized. Never point this at a
# broad host: /_next/image is public and gated only by this allowlist.
# NEXT_PUBLIC_AVATAR_BUCKET_HOST=pub-xxxxxxxx.r2.dev

# Public repo the "Edit on GitHub" doc link + footer link point at, AND the repo
# whose GitHub Releases back the desktop download + auto-update endpoints
# (/download*, /desktop/latest.json). Set this to your canonical repo (or fork).
# Defaults to the Skillet repo if unset. Its releases must be public for the
# download redirects to resolve for logged-out users.
NEXT_PUBLIC_GITHUB_REPO_URL=https://github.com/skilletmd/skillet

# Optional GitHub token for the release-resolver (higher API rate limit; also
# lets /download* resolve while the repo is still private pre-launch — though
# private release assets still won't download without auth). Read server-side only.
# SKILLET_RELEASES_TOKEN=

# Set to "1" ONLY when this origin sits behind Cloudflare (cf-connecting-ip is
# trustworthy there). The BFF then forwards cf-connecting-ip as X-Forwarded-For
# so the registry's per-IP rate limit keys on the real client. Leave UNSET on a
# non-proxied/local origin — the header is forgeable there. (Prod sets this in
# ecosystem.config.cjs.)
# TRUST_CF_CONNECTING_IP=1

# Content-Security-Policy mode (defense-in-depth, emitted from src/proxy.ts):
#   enforce      → send Content-Security-Policy (blocks violations) [production via ecosystem.config.cjs]
#   report-only  → send Content-Security-Policy-Report-Only (logs violations, blocks nothing)
#   off          → no CSP header (companion security headers still sent)
# Unknown/unset → report-only (safe default). See docs/security/content-security-policy.md.
# WEB_CSP_MODE=report-only

# Auth.js — generate AUTH_SECRET with: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# GitHub OAuth — callback http://localhost:3000/api/auth/callback/github
# Legacy GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET /
# GITHUB_OAUTH_REDIRECT_URI are still read as a fallback; don't set both.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Google OAuth — callback http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# X (Twitter) OAuth 2.0 — callback http://localhost:3000/api/auth/callback/twitter
AUTH_TWITTER_ID=
AUTH_TWITTER_SECRET=

# HMAC secret the web BFF signs internal registry calls with (session mint/refresh,
# identity link, repo connect). Must match packages/registry SKILLET_WEB_SIGNING_SECRET
# exactly. Generate a fresh value — do NOT ship a well-known default:
#   openssl rand -hex 32
# If left empty the web app FAILS CLOSED (no fallback constant). For local dev
# without a configured secret, set SKILLET_ENABLE_DEV_AUTH=1 (same flag the
# registry uses) to sign with a per-process placeholder instead.
SKILLET_WEB_SIGNING_SECRET=
# Optional second secret accepted during zero-downtime rotation:
# SKILLET_WEB_SIGNING_SECRET_PREVIOUS=
