{
  "name": "@skillet/desktop",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "description": "Skillet desktop (Tauri) — cross-platform menubar syncer",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter \"@skillet/desktop^...\" build && vitest run",
    "tauri": "tauri",
    "build:local": "pnpm prepare-sidecar && tauri build --config src-tauri/tauri.local.conf.json",
    "prepare-sidecar": "node scripts/prepare-skillet-sidecar.mjs",
    "notarize:macos": "node scripts/notarize-macos.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-updater": "^2",
    "@tauri-apps/plugin-process": "^2",
    "@skillet/protocol": "workspace:*",
    "marked": "^14.1.3",
    "dompurify": "^3.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^3.2.6",
    "happy-dom": "^20.8.9"
  },
  "license": "Apache-2.0"
}
