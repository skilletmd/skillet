{
  "name": "@skillet/core",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./kit": "./dist/kit/index.js",
    "./lock": "./dist/lock.js",
    "./metrics": "./dist/metrics.js"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "pnpm --filter \"@skillet/core^...\" build && vitest run",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@skillet/protocol": "workspace:*",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "fflate": "^0.8.2",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6"
  },
  "license": "Apache-2.0"
}
